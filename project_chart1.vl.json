{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "US Solar vs. Wind Generation, 2001–2025",
    "subtitle": "Annual electricity generation, thousand MWh (Live via EIA API)",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1F2A33",
    "subtitleColor": "#6B5B3E"
  },
  "width": "container",
  "height": 320,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#FAF8F4",
  "layer": [
    {
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=SUN&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      },
      "transform": [
        {"calculate": "toNumber(datum.generation)", "as": "generation_num"},
        {"calculate": "'Solar'", "as": "technology"}
      ],
      "mark": {"type": "line", "strokeWidth": 3, "point": {"filled": true, "size": 40, "opacity": 0}},
      "encoding": {
        "x": {"field": "period", "type": "ordinal", "title": null},
        "y": {"aggregate": "sum", "field": "generation_num", "type": "quantitative", "title": "Generation (thousand MWh)"},
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {"domain": ["Solar", "Wind"], "range": ["#D9A441", "#4A7C8C"]},
          "legend": {"title": "Technology", "orient": "bottom", "direction": "horizontal", "symbolType": "circle", "symbolSize": 100}
        }
      }
    },
    {
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=WND&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      },
      "transform": [
        {"calculate": "toNumber(datum.generation)", "as": "generation_num"},
        {"calculate": "'Wind'", "as": "technology"}
      ],
      "mark": {"type": "line", "strokeWidth": 3, "point": {"filled": true, "size": 40, "opacity": 0}},
      "encoding": {
        "x": {"field": "period", "type": "ordinal", "title": null},
        "y": {"aggregate": "sum", "field": "generation_num", "type": "quantitative", "title": "Generation (thousand MWh)"},
        "color": {
          "field": "technology",
          "type": "nominal",
          "scale": {"domain": ["Solar", "Wind"], "range": ["#D9A441", "#4A7C8C"]},
          "legend": {"title": "Technology", "orient": "bottom", "direction": "horizontal", "symbolType": "circle", "symbolSize": 100}
        }
      }
    },
    {
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=SUN&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      },
      "transform": [
        {"calculate": "toNumber(datum.generation)", "as": "generation_num"},
        {"aggregate": [{"op": "sum", "field": "generation_num", "as": "total"}], "groupby": ["period"]}
      ],
      "mark": {"type": "point", "opacity": 0.001},
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "fields": ["period"], "nearest": true, "on": "pointerover", "clear": "pointerout"}
        }
      ],
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "total", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": {"param": "hover", "empty": false}}],
      "mark": {"type": "rule", "color": "#9B8F75", "strokeDash": [3, 3]},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"}
      },
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=SUN&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      }
    },
    {
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=SUN&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      },
      "transform": [
        {"calculate": "toNumber(datum.generation)", "as": "generation_num"},
        {"aggregate": [{"op": "sum", "field": "generation_num", "as": "total"}], "groupby": ["period"]},
        {"filter": {"param": "hover", "empty": false}}
      ],
      "mark": {"type": "text", "dy": -14, "fontWeight": "bold", "fontSize": 12, "color": "#1B3A57"},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "total", "type": "quantitative"},
        "text": {"field": "total", "type": "quantitative", "format": ",.0f"}
      }
    },
    {
      "data": {
        "url": "https://api.eia.gov/v2/electricity/electric-power-operational-data/data/?api_key=hMkmtH8pLcGNkCFWmKkhztP7kqRPrbFbhhGdR9Bh&frequency=annual&data[0]=generation&facets[fueltypeid][]=WND&facets[sectorid][]=98&sort[0][column]=period&sort[0][direction]=asc&length=5000",
        "format": {"type": "json", "property": "response.data"}
      },
      "transform": [
        {"calculate": "toNumber(datum.generation)", "as": "generation_num"},
        {"aggregate": [{"op": "sum", "field": "generation_num", "as": "total"}], "groupby": ["period"]},
        {"filter": {"param": "hover", "empty": false}}
      ],
      "mark": {"type": "text", "dy": -14, "fontWeight": "bold", "fontSize": 12, "color": "#1F2A33"},
      "encoding": {
        "x": {"field": "period", "type": "ordinal"},
        "y": {"field": "total", "type": "quantitative"},
        "text": {"field": "total", "type": "quantitative", "format": ",.0f"}
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "axis": {
      "labelFont": "Inter, sans-serif",
      "labelColor": "#3A3A3A",
      "domainColor": "#DDD6C7",
      "tickColor": "#DDD6C7",
      "gridDash": [2, 3],
      "gridColor": "#DDD6C7",
      "gridOpacity": 0.6
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 13
    }
  }
}
