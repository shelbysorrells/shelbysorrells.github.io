{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 CO2-Emitting Countries by Year",
    "subtitle": "Annual CO2 emissions (million tonnes), 1990-2023",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 400,
  "autosize": {"type": "fit", "contains": "padding"},
  "params": [
    {
      "name": "year_select",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1990,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/shelbysorrells/shelbysorrells.github.io/refs/heads/main/co2_clean.json"
  },
  "transform": [
    {"filter": "datum.year == year_select"},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "co2", "order": "descending"}]},
    {"filter": "datum.rank <= 10"}
  ],
  "mark": {"type": "bar", "color": "#1B3A57"},
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "sort": {"field": "co2", "order": "descending"}
    },
    "x": {
      "field": "co2",
      "type": "quantitative",
      "title": "CO2 emissions (million tonnes)"
    },
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country"},
      {"field": "co2", "type": "quantitative", "title": "CO2 (Mt)"}
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "axis": {"labelFont": "Inter, sans-serif", "labelFontSize": 13}
  }
}
