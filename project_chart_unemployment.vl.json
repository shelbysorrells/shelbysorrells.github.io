{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "US Unemployment Rate by Race, 2024-2026",
    "subtitle": "Monthly rate by race/ethnicity; use the dropdown to change the axis starting point",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1A1A1A",
    "subtitleColor": "#5A5A5A"
  },
  "width": "container",
  "height": 340,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#F7F7F8",
  "params": [
    {
      "name": "y_min_select",
      "value": 2,
      "bind": {
        "input": "select",
        "options": [0, 2],
        "labels": ["Start at 0%", "Start at 2% (shows differences more clearly)"],
        "name": "Y-axis: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/shelbysorrells/shelbysorrells.github.io/refs/heads/main/bls_unemployment_all_races.json"
  },
  "mark": {"type": "line", "point": {"filled": true, "size": 30}, "strokeWidth": 2.2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "timeUnit": "yearmonth",
      "title": null
    },
    "y": {
      "field": "unemployment_rate",
      "type": "quantitative",
      "title": "Unemployment rate (%)",
      "scale": {"domainMin": {"expr": "y_min_select"}, "domainMax": 9}
    },
    "color": {
      "field": "race",
      "type": "nominal",
      "scale": {
        "domain": ["All workers (national rate)", "White", "Asian", "Hispanic or Latino", "Black"],
        "range": ["#AAAAAA", "#7A9CBF", "#6B8E7F", "#C9A227", "#9A3B00"]
      },
      "legend": {"title": null, "orient": "top", "direction": "horizontal", "columns": 3}
    },
    "tooltip": [
      {"field": "race", "type": "nominal", "title": "Group"},
      {"field": "date", "type": "temporal", "timeUnit": "yearmonth", "title": "Month"},
      {"field": "unemployment_rate", "type": "quantitative", "title": "Unemployment rate"}
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "axis": {
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#2A2A2A",
      "domainColor": "#CCCCCC",
      "tickColor": "#CCCCCC",
      "gridDash": [2, 3],
      "gridColor": "#DDDDDD",
      "gridOpacity": 0.7
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 12
    }
  }
}
