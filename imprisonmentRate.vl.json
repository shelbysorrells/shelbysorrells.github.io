{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "US Imprisonment Rate, 2008\u20132023",
    "subtitle": "Sentenced prisoners per 100,000 U.S. residents | BJS",
    "anchor": "start",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#0a0e75",
    "subtitleColor": "#43208a"
  },
  "height": 300,
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  "view": {"fill": "#ffffff", "strokeOpacity": 0},
  "data": {"url": "us-imprisonment-rate.json"},
  "mark": {"type": "line", "color": "#4B2E83", "strokeWidth": 2, "point": true},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "axis": {"title": "", "grid": false}},
    "y": {"field": "rate", "type": "quantitative", "axis": {"title": "Rate per 100,000", "titleColor": "#122B39", "grid": false}}
  },
  "config": {}
}
