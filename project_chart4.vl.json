{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The AR5 Collapse Was a Single Bad Year, Not a Lasting Trend",
    "subtitle": "UK offshore wind capacity secured per auction round, GW",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1F2A33",
    "subtitleColor": "#6B5B3E"
  },
  "width": "container",
  "height": 300,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#FAF8F4",
  "data": {
    "values": [
      {"round": "AR4 (2022)", "gw": 7.0},
      {"round": "AR5 (2023)", "gw": 0},
      {"round": "AR6 (2024)", "gw": 5.3},
      {"round": "AR7 (2026)", "gw": 8.4}
    ]
  },
  "encoding": {
    "x": {
      "field": "round",
      "type": "nominal",
      "title": null,
      "sort": ["AR4 (2022)", "AR5 (2023)", "AR6 (2024)", "AR7 (2026)"],
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "gw",
      "type": "quantitative",
      "title": "Offshore wind capacity secured (GW)",
      "scale": {"domain": [0, 9.5]}
    },
    "color": {
      "condition": {"test": "datum.round == 'AR5 (2023)'", "value": "#1B3A57"},
      "value": "#4A7C8C"
    },
    "tooltip": [
      {"field": "round", "type": "nominal", "title": "Auction round"},
      {"field": "gw", "type": "quantitative", "title": "Capacity (GW)"}
    ]
  },
  "layer": [
    {"mark": {"type": "bar", "size": 70}},
    {
      "mark": {"type": "text", "dy": -10, "fontWeight": "bold", "fontSize": 13, "color": "#1F2A33"},
      "encoding": {
        "text": {"field": "gw", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "axis": {
      "labelFont": "Inter, sans-serif",
      "labelColor": "#3A3A3A",
      "labelFontSize": 13,
      "domainColor": "#DDD6C7",
      "tickColor": "#DDD6C7",
      "gridDash": [2, 3],
      "gridColor": "#DDD6C7",
      "gridOpacity": 0.6
    }
  }
}
