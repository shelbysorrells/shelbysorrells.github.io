{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "UK Offshore Wind Capacity by Project Status",
  "width": 500,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/shelbysorrells/shelbysorrells.github.io/refs/heads/main/uk_offshore_wind.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {"field": "status", "type": "nominal", "title": "Status", "sort": "-y"},
    "y": {"aggregate": "sum", "field": "capacity_mw", "type": "quantitative", "title": "Total Capacity (MW)"},
    "tooltip": [
      {"field": "status", "type": "nominal", "title": "Status"},
      {"aggregate": "sum", "field": "capacity_mw", "type": "quantitative", "title": "Total Capacity (MW)", "format": ","}
    ]
  }
}
