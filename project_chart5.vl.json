{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Retail Was the Only Sector With a Holdout",
    "subtitle": "% of tracked companies in each sector that dropped DEI language by 2026",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1A1A1A",
    "subtitleColor": "#5A5A5A"
  },
  "width": "container",
  "height": 260,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#F7F7F8",
  "data": {
    "url": "https://raw.githubusercontent.com/shelbysorrells/shelbysorrells.github.io/refs/heads/main/dei_sector_retreat.json"
  },
  "encoding": {
    "x": {
      "field": "sector",
      "type": "nominal",
      "title": null,
      "sort": ["Tech", "Finance", "Retail"],
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "pct_retreated",
      "type": "quantitative",
      "title": "% of companies that dropped DEI language",
      "scale": {"domain": [0, 110]}
    },
    "color": {"value": "#1B3A57"},
    "tooltip": [
      {"field": "sector", "type": "nominal", "title": "Sector"},
      {"field": "pct_retreated", "type": "quantitative", "title": "% dropped language"},
      {"field": "companies", "type": "nominal", "title": "Detail"}
    ]
  },
  "layer": [
    {"mark": {"type": "bar", "size": 90}},
    {
      "mark": {"type": "text", "dy": -12, "fontWeight": "bold", "fontSize": 14, "color": "#1A1A1A"},
      "encoding": {
        "text": {"field": "pct_retreated", "type": "quantitative", "format": ".0f"}
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "axis": {
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 14,
      "labelColor": "#2A2A2A",
      "domainColor": "#CCCCCC",
      "tickColor": "#CCCCCC",
      "gridDash": [2, 3],
      "gridColor": "#DDDDDD",
      "gridOpacity": 0.7
    }
  }
}
