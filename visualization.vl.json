{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Renewables in the US",
    "anchor": "start",
    "subtitle": "Output, GWh, | IEA via ECO-API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#0a0e75",
    "subtitleColor": "#43208a"
  },
  "height": "300",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  "view": {"fill": "#ffffff", "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/usa/rGWh?vega",
    "format": {"type": "json", "property": "data"}
},
  },
  "mark": {"type": "line", "color": "#d6355dee", "strokeWidth": "2"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    }
  },
  "config": {}
}
