{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Wind Absorbs the Brunt of the OBBBA's Rollback",
    "subtitle": "Forecast cut to 2025-2030 US capacity additions, vs. pre-OBBBA outlook",
    "anchor": "start",
    "font": "Merriweather, serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1F2A33",
    "subtitleColor": "#6B5B3E"
  },
  "width": "container",
  "height": 220,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#FAF8F4",
  "data": {
    "values": [
      {"technology": "Onshore Wind", "cut_pct": 50},
      {"technology": "Solar", "cut_pct": 23},
      {"technology": "Energy Storage", "cut_pct": 7}
    ]
  },
  "encoding": {
    "y": {
      "field": "technology",
      "type": "nominal",
      "title": null,
      "sort": ["Onshore Wind", "Solar", "Energy Storage"]
    },
    "x": {
      "field": "cut_pct",
      "type": "quantitative",
      "title": "Forecast cut (%)",
      "scale": {"domain": [0, 60]}
    },
    "color": {
      "field": "technology",
      "type": "nominal",
      "scale": {
        "domain": ["Onshore Wind", "Solar", "Energy Storage"],
        "range": ["#4A7C8C", "#D9A441", "#9B8F75"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "technology", "type": "nominal", "title": "Technology"},
      {"field": "cut_pct", "type": "quantitative", "title": "Forecast cut (%)"}
    ]
  },
  "layer": [
    {"mark": {"type": "bar", "size": 36}},
    {
      "transform": [{"calculate": "datum.cut_pct + '%'", "as": "label"}],
      "mark": {"type": "text", "dx": 20, "fontWeight": "bold", "fontSize": 13, "color": "#1F2A33"},
      "encoding": {
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "axis": {
      "labelFont": "Inter, sans-serif",
      "labelColor": "#3A3A3A",
      "labelFontSize": 13,
      "domainColor": "#DDD6C7",
      "tickColor": "#DDD6C7",
      "gridDash": [2, 3],
      "gridColor": "#DDD6C7",
      "gridOpacity": 0.6
    }
  }
}
